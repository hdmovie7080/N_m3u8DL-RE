# ===================================================================
# SONY YAY! SonyLIV Recording Bot - Configuration Template
# ===================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub - it contains sensitive data!

# ===================================================================
# TELEGRAM CONFIGURATION (REQUIRED)
# ===================================================================

# Get from https://my.telegram.org/apps
API_ID=123456789
API_HASH=abcd1234efgh5678ijkl9012mnop3456

# Get from @BotFather on Telegram
BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdef123

# Your Telegram User ID (get from @userinfobot)
OWNER_ID=987654321

# ===================================================================
# SONY YAY! STREAM CONFIGURATION
# ===================================================================

# M3U8 Stream URL (default: SONY YAY! stream)
SONY_STREAM_URL=https://sliv.tgaadi.workers.dev/sonyyaysd.m3u8

# ===================================================================
# FILE UPLOAD CONFIGURATION
# ===================================================================

# GoFile Token (optional, for GoFile uploads)
# Get from https://gofile.io/api
GOFILE_TOKEN=

# ===================================================================
# RECORDING CONFIGURATION
# ===================================================================

# Directory for storing recordings
# Docker: /app/recordings (don't change)
# Local: ./recordings (or your preferred path)
RECORDINGS_DIR=./recordings

# Maximum concurrent recordings
# Higher value = more resource usage
# Default: 3 (Recommended: 2-5)
MAX_CONCURRENT_RECORDINGS=3

# Maximum file size in MB
# Default: 4096 (4GB, Telegram limit)
MAX_FILE_SIZE_MB=4096

# ===================================================================
# LOGGING CONFIGURATION
# ===================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Recommended: INFO
LOG_LEVEL=INFO

# ===================================================================
# NOTES
# ===================================================================
#
# 1. REQUIRED FIELDS (must be filled):
#    - API_ID
#    - API_HASH
#    - BOT_TOKEN
#    - OWNER_ID
#
# 2. OPTIONAL FIELDS (have defaults):
#    - SONY_STREAM_URL (default: SONY URL)
#    - GOFILE_TOKEN (only needed for GoFile uploads)
#    - RECORDINGS_DIR (default: ./recordings)
#    - MAX_CONCURRENT_RECORDINGS (default: 3)
#    - LOG_LEVEL (default: INFO)
#
# 3. GETTING VALUES:
#    - API_ID & API_HASH: https://my.telegram.org/apps
#    - BOT_TOKEN: Message @BotFather and /newbot
#    - OWNER_ID: Message @userinfobot to get your ID
#    - GOFILE_TOKEN: https://gofile.io/api (optional)
#
# 4. SECURITY:
#    - NEVER share your .env file
#    - NEVER commit .env to version control
#    - Keep BOT_TOKEN and API credentials private
#    - Use .gitignore to prevent accidental commits
#
# ===================================================================
